#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/xgp-screen-daemon

start_service() {
    local enabled
    config_load xgp_screen
    config_get enabled config enabled 1

    if [ "$enabled" != "1" ]; then
        /usr/bin/xgp-screen-ctrl off
        /etc/init.d/zz_xgp_screen stop 2>/dev/null
        return 0
    fi

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/xgp-screen-ctrl off
}

service_triggers() {
    procd_add_reload_trigger "xgp_screen"
}

